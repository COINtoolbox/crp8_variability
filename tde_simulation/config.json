{
  "ztf_files_path": "example/input/*csv",
  "search_radius_arcsec": 1.2,
  "tide_path": "/path/to/tide_installation/",
  "output_dir": "example/output",
  "bh_mass": {
    "min": 1e2,
    "max": 1e6
  },

  "star_mstar": {
    "min": 0.1,
    "max": 30
  },
  "coordinates_file": "example/extragalactic_coordinates.csv",

  "star_rstar": {
    "mode": "mixed",
    "categorical": ["ms", "wd"],
    "continuous": {
      "min": 0.1,
      "max": 10.0
    }
  },
  "use_p_nu_scaling": [true],
  "distance_mpc": 100,
  "save_plots": true,
  "filters": ["zg", "zr"]
}
